{
  "expo": {
    "name": "my-directory",
    "slug": "my-directory",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "mydirectory",
    "userInterfaceStyle": "automatic",
    "version": "1.0.4",
    "android": {
      "versionCode": 4,
      "package": "com.faustinodina.mydirectory",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faustinodina.mydirectory.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "faustino-dina-rivas"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a53a9ba-f5c1-4757-aeda-cabd54119062"
      }
    },
    "owner": "faustino-dina"
  }
}
